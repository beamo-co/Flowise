# =============================================================================
# Local Agent OS - Environment Configuration
# =============================================================================

# =============================================================================
# Flowise Configuration
# =============================================================================
FLOWISE_PORT=3000
FLOWISE_SECRETKEY=your-secret-key-here
DATABASE_TYPE=sqlite
DATABASE_PATH=/root/.flowise

# =============================================================================
# Claude Worker Configuration
# =============================================================================
# Worker service port
WORKER_PORT=3001

# Worker role: coding | support
WORKER_ROLE=coding

# Session namespace for this worker
SESSION_NAMESPACE=default

# Data root directory (inside container)
DATA_ROOT=/data

# Maximum concurrent jobs
MAX_CONCURRENCY=2

# Optional: Claude Code CLI path (for local execution)
# CLAUDE_CODE_PATH=/usr/local/bin/claude

# =============================================================================
# Slack Bridge Configuration
# =============================================================================
SLACK_BRIDGE_PORT=3002

# Slack Bot Token (starts with xoxb-)
SLACK_BOT_TOKEN=

# Slack App Token (starts with xapp-)
SLACK_APP_TOKEN=

# Slack Signing Secret
SLACK_SIGNING_SECRET=

# Flowise URL (internal)
FLOWISE_URL=http://flowise:3000

# =============================================================================
# Claude Worker URL (for Flowise to call)
# =============================================================================
CLAUDE_WORKER_URL=http://claude-worker-coding:3001
